<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Barras do sistema escuras, da cor do topo do app. O fundo da janela é o que aparece
             atrás delas quando o Android desenha o app de ponta a ponta. -->
        <item name="android:windowBackground">@color/provink_bars</item>
        <item name="android:statusBarColor">@color/provink_bars</item>
        <item name="android:navigationBarColor">@color/provink_bars</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+: abertura do sistema (ícone sobre fundo preto, igual à abertura do app). -->
        <item name="windowSplashScreenBackground">#050505</item>
    </style>
</resources>